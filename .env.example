# Copier ce fichier en .env et renseigner les clés.

# Obligatoire pour la génération (réponses, MultiQuery, HyDE, agents, RAGAS) — https://console.groq.com
GROQ_API_KEY=

# Optionnel : reranking Cohere (mode « advanced »). Sans clé, l'ordre RRF est conservé.
COHERE_API_KEY=

# Knowledge Graph (Graph RAG) — instance Neo4j Desktop locale
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optionnel : traces LangFuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Surcharges possibles (valeurs par défaut dans app/config.py)
# EMBEDDING_MODEL=intfloat/multilingual-e5-base
# LLM_MODEL=openai/gpt-oss-120b
# FAST_LLM_MODEL=openai/gpt-oss-20b
# TOP_K=5
# CHUNK_SIZE=1500
